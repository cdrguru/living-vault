{
  "name": "the-living-vault",
  "description": "Local-first system of record and effectiveness monitor for agentic assets: skills, subagents, MCP servers, and bundles.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/cdrguru/living-vault"
  },
  "homepage": "https://github.com/cdrguru/living-vault#readme",
  "scripts": {
    "dev": "vite --mode public",
    "build": "tsc -b && vite build",
    "prebuild:swa": "node scripts/build-collect.mjs && npm run gen:demo-telemetry",
    "build:swa": "node scripts/build-swa.mjs",
    "postbuild:swa": "npm run guard:artifacts",
    "guard:artifacts": "node scripts/guards/no-secrets-guard.mjs dist && node scripts/guards/local-telemetry-guard.mjs dist",
    "build:collect": "node scripts/build-collect.mjs",
    "gen:demo-telemetry": "tsx scripts/generate-demo-telemetry.mts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.public.ts",
    "test:public": "vitest run --config vitest.config.public.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@microsoft/rayfin-auth-provider-fabric": "^1.33.1",
    "@microsoft/rayfin-client": "^1.33.1",
    "@microsoft/rayfin-core": "^1.33.1",
    "@microsoft/rayfin-data": "^1.33.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.1.11",
    "gsap": "^3.15.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.8.1",
    "tsx": "^4.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "^1.33.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^24.1.0",
    "playwright": "^1.61.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
